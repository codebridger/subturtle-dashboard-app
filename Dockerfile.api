# API-only image for Cloud Run. Firebase Hosting serves the dashboard, and every setting
# comes from the environment and Secret Manager at runtime: no .env file is baked in.
# Only package manifests, the vendored modular-rest tarball and src/ are copied, so a
# local build never picks up the host's node_modules, dist or .env.
FROM node:22.17.1-alpine AS build
WORKDIR /app
COPY server/package.json server/yarn.lock ./
COPY server/vendor ./vendor
RUN yarn install --frozen-lockfile
COPY server/tsconfig.json ./
COPY server/src ./src
RUN yarn build

FROM node:22.17.1-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY server/package.json server/yarn.lock ./
COPY server/vendor ./vendor
RUN yarn install --frozen-lockfile --production && yarn cache clean
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
