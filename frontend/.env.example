# Read by `nuxt generate` and baked into the build (window.__NUXT__.config in
# index.html), so each environment needs its own build — changing them on the
# host afterwards has no effect.

# API origin. Empty means the API is served from the dashboard's own origin.
NUXT_PUBLIC_BASE_URL_API=http://localhost:8080
# "production" switches on production-only behaviour; anything else is non-production.
NUXT_PUBLIC_MODE=development
NUXT_PUBLIC_MIXPANEL_PROJECT_TOKEN=
NUXT_PUBLIC_MIXPANEL_API_HOST=
NUXT_PUBLIC_CHROME_WEB_STORE_URL=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
