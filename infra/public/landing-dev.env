# Public build-time values for the dev marketing site (they ship to every browser; no secrets).
# Reached only on its default host: no custom domain, so it never competes with subturtle.app.
NUXT_PUBLIC_SITE_URL=https://subturtle-landing-dev.web.app
NUXT_PUBLIC_DASHBOARD_URL=https://dev.dashboard.subturtle.app
# Ad conversions are production's; the dev site never loads the tag.
NUXT_PUBLIC_GOOGLE_ADS_ID=
NUXT_PUBLIC_FILM_YOUTUBE_ID=sKnp18PyKKM
NUXT_PUBLIC_PRODUCT_HUNT_POST_ID=
NUXT_PUBLIC_PRODUCT_HUNT_POST_SLUG=
