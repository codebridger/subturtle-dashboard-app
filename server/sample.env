# Admin user — auto-created on server boot, loginable via POST /user/login. These
# are the default credentials for browser validation (token injection); see
# CLAUDE.md "Verifying changes in the browser".
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# Comma-separated OAuth client IDs whose Google access tokens the extension may send to
# /auth/google/access-token-login, besides GOOGLE_OAUTH_CLIENT_ID. List old and new IDs
# together while a client migration rolls out to installed extensions.
GOOGLE_OAUTH_CLIENT_ID_EXTENSION=
API_BASE_URL=
DASHBOARD_BASE_URL=

# MongoDB. By default each logical database is its own database: MONGO_DB_PREFIX + name.
MONGO_BASE_ADDRESS=mongodb://localhost:27017
MONGO_DB_PREFIX=subturtle_dev_
# "true" stores every logical database (cms, user_content) in the one database named in
# the path of MONGO_BASE_ADDRESS. Required for Firestore with MongoDB compatibility:
# mongodb://USER:PASS@UID.LOCATION.firestore.goog:443/DATABASE_ID?loadBalanced=true&tls=true&retryWrites=false&authMechanism=SCRAM-SHA-256
MONGO_SINGLE_DATABASE=

# Scheduled jobs (server/src/modules/schedule/service.ts).
# interval (default): run due jobs in-process every SCHEDULE_INTERVAL_SECONDS (60).
# http: Cloud Scheduler calls POST /schedule/tick with an OIDC token whose audience is
# SCHEDULE_TICK_AUDIENCE (the service URL), signed as SCHEDULE_TICK_INVOKER (its
# service account email). Use http wherever instances scale to zero.
SCHEDULE_DRIVER=
SCHEDULE_INTERVAL_SECONDS=
SCHEDULE_TICK_AUDIENCE=
SCHEDULE_TICK_INVOKER=

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Without it, /gateway/webhook/stripe accepts unsigned events; set it in every deployment.
STRIPE_WEBHOOK_SECRET=

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
GCP_API_KEY=

# Gemini API Key (used by the Live API)
GEMINI_API_KEY=

# Mixpanel project token for server-truth analytics events (trial/subscription
# lifecycle, AI-budget exhaustion, translation usage). Use the production
# project token in prod ("Subturtle Legacy") and the dev project token locally
# ("Subturtle-dev"). When unset, server-side analytics are disabled.
MIXPANEL_TOKEN=

# RSA keypair that signs session JWTs. Required when NODE_ENV=production: without it a
# new pair is generated at every boot and every signed-in user is logged out.
PRIVATE_KEY=
PUBLIC_KEY=
