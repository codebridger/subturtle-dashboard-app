# Admin user — auto-created on server boot, loginable via POST /user/login. These
# are the default credentials for browser validation (token injection); see
# CLAUDE.md "Verifying changes in the browser".
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID_EXTENSION=
API_BASE_URL=
DASHBOARD_BASE_URL=

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
GCP_API_KEY=

# Gemini API Key (used by the Live API)
GEMINI_API_KEY=

# Mixpanel project token for server-truth analytics events (trial/subscription
# lifecycle, AI-budget exhaustion, translation usage). Use the production
# project token in prod ("Subturtle Legacy") and the dev project token locally
# ("Subturtle-dev"). When unset, server-side analytics are disabled.
MIXPANEL_TOKEN=

# RSA Keypair
PRIVATE_KEY=
PUBLIC_KEY=
