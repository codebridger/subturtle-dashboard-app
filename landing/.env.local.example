# Copy to .env.local (gitignored). See README.md for every variable.
NUXT_PUBLIC_SITE_URL=http://localhost:3100
NUXT_PUBLIC_DASHBOARD_URL=https://dev.dashboard.subturtle.app
# Optional: the dev Mixpanel project token (infra/public/dev.env) turns on the consent banner.
NUXT_PUBLIC_MIXPANEL_PROJECT_TOKEN=
# Optional, `nuxt dev` only: put the film master at .film/subturtle-film.mp4.
NUXT_PUBLIC_FILM_SRC=
